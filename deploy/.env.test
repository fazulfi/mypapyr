# CI-only non-secret fixture for `docker compose config --quiet`.
# Mirrors the five required backend settings with the same dummy values the
# backend-test job injects (backend/app/config.py REQUIRED_ENV_VARS). Used
# only to render the Compose model in CI; never used to run or deploy.
R2_ACCOUNT_ID=test
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET_NAME=test
ALLOWED_ORIGINS=http://localhost:3000
