# Papyr production environment — non-secret template only.
#
# This file is intentionally safe to commit. Every value below is either
# empty or a clearly-marked placeholder such as `__SET_ME__` or `changeme`.
#
# DO NOT put any of the following here:
#   - real database connection strings
#   - real API keys, tokens, OAuth client secrets
#   - real hostnames, IP addresses, or domain names
#   - real TLS cert paths or private key material
#
# Operational rules:
#   - On a production host this file ships as a template only; the real
#     `.env.production` is provisioned separately, installed with mode 0600,
#     and owned by a dedicated non-root service account. Never deploy this
#     template as-is.
#   - The five variables under "Foundation required settings" are boot-time
#     requirements and are intentionally EMPTY here: `backend/app/config.py`
#     rejects empty required variables at boot, so any accidental load of
#     this template fails fast (crash loop; healthcheck never healthy)
#     instead of booting with placeholder credentials. The real
#     `.env.production` MUST supply real values for all five.
#
# Git tracking: this file is matched by `.gitignore` rule `!.env.*.example`,
# so it is tracked-eligible while real `.env*` files remain ignored.

# --- Application runtime --------------------------------------------------
APP_ENV=production
# Documentation of the compose/nginx/image port contract (3000); the
# foundation image binds 3000 (Dockerfile.production CMD).
API_PORT=3000
LOG_LEVEL=info

# --- Foundation required settings (boot-time; empty ON PURPOSE) -------------
# These five are boot-time requirements rejected when empty
# (backend/app/config.py). They are intentionally left EMPTY so this
# template can never boot a container with placeholder credentials: real
# values are provisioned out of band into `.env.production` (mode 0600).
# Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Comma-separated origin allowlist; e.g. https://budgezen.com
ALLOWED_ORIGINS=

# --- Backend service wiring --------------------------------------------------
# REDIS_URL is READ by the API image (backend/app/config.py, BE-01/BE-04):
# it is the compose network binding for the task store the BE-06 status and
# BE-09 download routers read. `redis` is the compose service name (internal
# network alias); the api and redis containers must share the papyr-app
# compose network for this to resolve. DATABASE_URL and PAPYR_AI_BASE_URL
# remain reserved for future integrations the image does not read yet.
REDIS_URL=redis://redis:6379/0
DATABASE_URL=changeme
PAPYR_AI_BASE_URL=__SET_ME__

# --- Optional Phase 3 operational knobs (BE-01; approved defaults) ----------
# Every knob below is optional: backend/app/config.py applies the
# owner-approved default (gate-entry.md R-03/R-07/R-09) when unset or empty.
# Values shown are the approved defaults, kept in sync with config.py; they
# are non-secret tuning numbers, safe to commit in this template.
REDIS_MAXMEMORY_BYTES=402653184              # 384 MiB (R-09)
REDIS_EVICTION_POLICY=noeviction             # R-09
R2_REGION=auto
RETENTION_SECONDS=3600                       # R-03; one-hour ceiling (DEC-070)
MAX_WAIT_SECONDS=900                         # R-03
MAX_QUEUE_LENGTH=2000                        # R-03
MAX_CONCURRENT_PER_ORIGIN=4                  # R-03 (R-08)
DEFAULT_TIMEOUT_SECONDS=180                  # R-03
WORKER_CPUS=1.5                              # R-07
WORKER_MEMORY_BYTES=2147483648               # 2 GiB (R-07)
