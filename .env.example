# Papyr — environment variable contract (names only)
#
# Public-safe template. Every value is the literal `__SET_ME__` placeholder.
# Provision real values through an approved secret-management procedure and
# never put them in source, issues, pull requests, logs, images, or backups.
#
# When adding a variable, place it under the appropriate group and leave the
# value as `__SET_ME__`.

# --------------------------------------------------------------------------
# GitHub
# --------------------------------------------------------------------------
GITHUB_ACCOUNT=__SET_ME__
GITHUB_REPO_NAME=__SET_ME__
GITHUB_DEFAULT_BRANCH=__SET_ME__

# --------------------------------------------------------------------------
# Vercel
# --------------------------------------------------------------------------
VERCEL_ORG=__SET_ME__
VERCEL_PROJECT_NAME=__SET_ME__

# --------------------------------------------------------------------------
# Cloudflare
# --------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=__SET_ME__
CLOUDFLARE_API_TOKEN=__SET_ME__

# --------------------------------------------------------------------------
# Cloudflare R2 (object storage)
# --------------------------------------------------------------------------
R2_ACCESS_KEY_ID=__SET_ME__
R2_SECRET_ACCESS_KEY=__SET_ME__
R2_BUCKET_NAME=__SET_ME__
R2_ENDPOINT=__SET_ME__
R2_REGION=__SET_ME__

# --------------------------------------------------------------------------
# Backend (FastAPI service) — optional operational knobs
# --------------------------------------------------------------------------
# Phase 3 (BE-01) optional settings, documented for the contract (names
# only). Every knob has an owner-approved default in backend/app/config.py
# (gate-entry.md R-03/R-07/R-09), so these are never boot requirements:
# leave them unset to keep the defaults.
LOG_LEVEL=__SET_ME__
REDIS_URL=__SET_ME__
REDIS_MAXMEMORY_BYTES=__SET_ME__
REDIS_EVICTION_POLICY=__SET_ME__
RETENTION_SECONDS=__SET_ME__
MAX_WAIT_SECONDS=__SET_ME__
MAX_QUEUE_LENGTH=__SET_ME__
MAX_CONCURRENT_PER_ORIGIN=__SET_ME__
DEFAULT_TIMEOUT_SECONDS=__SET_ME__
WORKER_CPUS=__SET_ME__
WORKER_MEMORY_BYTES=__SET_ME__

# --------------------------------------------------------------------------
# Backup S3 (operational backup destination)
# --------------------------------------------------------------------------
BACKUP_S3_ACCESS_KEY_ID=__SET_ME__
BACKUP_S3_SECRET_ACCESS_KEY=__SET_ME__
BACKUP_S3_BUCKET=__SET_ME__
BACKUP_S3_ENDPOINT=__SET_ME__

# --------------------------------------------------------------------------
# AI gateway (OpenAI-compatible)
# --------------------------------------------------------------------------
PAPYR_AI_API_KEY=__SET_ME__
PAPYR_AI_BASE_URL=__SET_ME__
PAPYR_AI_MODEL=__SET_ME__

# --------------------------------------------------------------------------
# Adsterra (advertising)
# --------------------------------------------------------------------------
ADSTERRA_PUBLISHER_ID=__SET_ME__
ADSTERRA_PLACEMENT_IDS=__SET_ME__
ADSTERRA_API_KEY=__SET_ME__

# --------------------------------------------------------------------------
# Telegram (owner alerting)
# --------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=__SET_ME__
TELEGRAM_CHAT_ID=__SET_ME__

# --------------------------------------------------------------------------
# Sentry (error monitoring)
# --------------------------------------------------------------------------
SENTRY_DSN=__SET_ME__

# --------------------------------------------------------------------------
# VPS (operational access)
# --------------------------------------------------------------------------
VPS_HOST=__SET_ME__
VPS_USER=__SET_ME__
VPS_SSH_PORT=__SET_ME__
VPS_DOMAIN=__SET_ME__
