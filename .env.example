# Papyr — environment variable contract (names only)
#
# Public-safe template. Every value is the literal `__SET_ME__` placeholder.
# Provision real values through an approved secret-management procedure and
# never put them in source, issues, pull requests, logs, images, or backups.
#
# When adding a variable, place it under the appropriate group and leave the
# value as `__SET_ME__`.

# --------------------------------------------------------------------------
# GitHub
# --------------------------------------------------------------------------
GITHUB_ACCOUNT=__SET_ME__
GITHUB_REPO_NAME=__SET_ME__
GITHUB_DEFAULT_BRANCH=__SET_ME__

# --------------------------------------------------------------------------
# Vercel
# --------------------------------------------------------------------------
VERCEL_ORG=__SET_ME__
VERCEL_PROJECT_NAME=__SET_ME__

# --------------------------------------------------------------------------
# Cloudflare
# --------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=__SET_ME__
CLOUDFLARE_API_TOKEN=__SET_ME__

# --------------------------------------------------------------------------
# Cloudflare R2 (object storage)
# --------------------------------------------------------------------------
# R2_ACCOUNT_ID is BOOT-REQUIRED by the backend (backend/app/config.py
# REQUIRED_ENV_VARS): the service fails fast when it is missing or empty.
# It is also the fallback account id for Cloudflare Email Sending delivery
# when CF_EMAIL_ACCOUNT_ID is unset.
R2_ACCOUNT_ID=__SET_ME__
R2_ACCESS_KEY_ID=__SET_ME__
R2_SECRET_ACCESS_KEY=__SET_ME__
R2_BUCKET_NAME=__SET_ME__
R2_ENDPOINT=__SET_ME__
R2_REGION=__SET_ME__

# --------------------------------------------------------------------------
# Backend (FastAPI service) — optional operational knobs
# --------------------------------------------------------------------------
# Phase 3 (BE-01) optional settings, documented for the contract (names
# only). Every knob has an owner-approved default in backend/app/config.py
# (gate-entry.md R-03/R-07/R-09), so these are never boot requirements:
# leave them unset to keep the defaults.
LOG_LEVEL=__SET_ME__
REDIS_URL=__SET_ME__
REDIS_MAXMEMORY_BYTES=__SET_ME__
REDIS_EVICTION_POLICY=__SET_ME__
RETENTION_SECONDS=__SET_ME__
MAX_WAIT_SECONDS=__SET_ME__
MAX_QUEUE_LENGTH=__SET_ME__
MAX_CONCURRENT_PER_ORIGIN=__SET_ME__
DEFAULT_TIMEOUT_SECONDS=__SET_ME__
WORKER_CPUS=__SET_ME__
WORKER_MEMORY_BYTES=__SET_ME__
# ClamAV scanner wiring (defaults: localhost:3310, enabled). The compose
# stack overrides CLAMD_HOST to the clamd service DNS; SCANNER_ENABLED=false
# is the explicit opt-out when no scanner is deployed.
CLAMD_HOST=__SET_ME__
CLAMD_PORT=__SET_ME__
SCANNER_ENABLED=__SET_ME__

# --------------------------------------------------------------------------
# Cloudflare Email Sending (PT-03 contact delivery) — optional backend
# --------------------------------------------------------------------------
# CF_EMAIL_API_TOKEN is REQUIRED for real delivery but OPT-IN at boot: the
# backend still accepts and 202-acknowledges contact submissions without it,
# counting the undeliverable email as a delivery failure. Set it to enable
# outbound mail. CF_EMAIL_ACCOUNT_ID defaults to R2_ACCOUNT_ID when unset.
# CONTACT_RECIPIENT/CONTACT_FROM_DOMAIN have owner-approved defaults
# (privacy@mypapyr.com / mypapyr.com) in backend/app/config.py.
CF_EMAIL_API_TOKEN=__SET_ME__
CF_EMAIL_ACCOUNT_ID=__SET_ME__
CONTACT_RECIPIENT=__SET_ME__
CONTACT_FROM_DOMAIN=__SET_ME__

# --------------------------------------------------------------------------
# Cloudflare Turnstile (PT-03) — optional soft gate
# --------------------------------------------------------------------------
# TURNSTILE_SITE_SECRET (backend siteverify) and NEXT_PUBLIC_TURNSTILE_SITE_KEY
# (frontend render) are both optional; when either is unset the respective
# side is silently disabled and the contact flow still works.
TURNSTILE_SITE_SECRET=__SET_ME__
NEXT_PUBLIC_TURNSTILE_SITE_KEY=__SET_ME__

# --------------------------------------------------------------------------
# Backup S3 (operational backup destination)
# --------------------------------------------------------------------------
BACKUP_S3_ACCESS_KEY_ID=__SET_ME__
BACKUP_S3_SECRET_ACCESS_KEY=__SET_ME__
BACKUP_S3_BUCKET=__SET_ME__
BACKUP_S3_ENDPOINT=__SET_ME__

# --------------------------------------------------------------------------
# Encrypted restic backup (OP-04, placeholders only)
# --------------------------------------------------------------------------
# Scope is privacy-enforced by an allowlist manifest passed via --files-from
# (deploy/backup/backup-scope.txt): only those configuration paths are read,
# so document data, R2 objects, queue payloads, uploads, results, Redis, and
# credentials structurally cannot enter the repository. RESTIC_REPOSITORY and
# the RESTIC_PASSWORD_FILE (a mode-0600 regular file) are supplied out of
# band; the RESTIC_KEEP_* retention families stay placeholders pending the
# R-13 owner approval and the script applies them only in run mode.
RESTIC_REPOSITORY=__SET_ME__
RESTIC_PASSWORD_FILE=__SET_ME__
PAPYR_BACKUP_ROOT=__SET_ME__
PAPYR_BACKUP_SCOPE=__SET_ME__
RESTIC_KEEP_DAILY=__SET_ME__
RESTIC_KEEP_WEEKLY=__SET_ME__
RESTIC_KEEP_MONTHLY=__SET_ME__
RESTIC_KEEP_YEARLY=__SET_ME__

# --------------------------------------------------------------------------
# AI gateway (OpenAI-compatible)
# --------------------------------------------------------------------------
PAPYR_AI_API_KEY=__SET_ME__
PAPYR_AI_BASE_URL=__SET_ME__
PAPYR_AI_MODEL=__SET_ME__

# --------------------------------------------------------------------------
# Adsterra (advertising)
# --------------------------------------------------------------------------
# NOTE: NOT read by any code in this repository. The frontend keeps the
# owner-approved zone keys hardcoded in frontend/src/lib/ads.ts (client-side
# public identifiers) and reads no Adsterra variables from the environment.
# These three names are listed as a dead contract only — removing them
# changes nothing at build or runtime.
ADSTERRA_PUBLISHER_ID=__SET_ME__
ADSTERRA_PLACEMENT_IDS=__SET_ME__
ADSTERRA_API_KEY=__SET_ME__

# --------------------------------------------------------------------------
# Telegram (owner alerting)
# --------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=__SET_ME__
TELEGRAM_CHAT_ID=__SET_ME__

# --------------------------------------------------------------------------
# Sentry (error monitoring)
# --------------------------------------------------------------------------
SENTRY_DSN=__SET_ME__

# --------------------------------------------------------------------------
# VPS (operational access)
# --------------------------------------------------------------------------
VPS_HOST=__SET_ME__
VPS_USER=__SET_ME__
VPS_SSH_PORT=__SET_ME__
VPS_DOMAIN=__SET_ME__
