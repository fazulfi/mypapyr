{
  "name": "papyr-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js frontend foundation for the Papyr PDF platform.",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y/ --project=chromium-desktop",
    "test:perf": "node perf-assert.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@swc/helpers": "0.5.23",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "fflate": "0.8.2",
    "next": "^16.2.12",
    "next-intl": "^4.13.5",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.10.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "lighthouse": "13.4.1",
    "postcss": "^8.5.18",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "$postcss",
    "nanoid": "3.3.18"
  }
}
