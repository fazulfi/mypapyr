{
  "name": "papyr-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js frontend foundation for the Papyr PDF platform.",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "$postcss"
  }
}
