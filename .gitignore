# Papyr repository ignore rules

# ===== Secrets: never commit =====
.env
.env.*
!.env.example
!.env.*.example
# CI Compose fixture: deploy/.env.test carries only non-secret dummy values for
# `docker compose config --quiet`; unlike the secrets matched by .env.* it is
# a tracked, reviewer-visible deliverable (never a real credential file).
!deploy/.env.test
# Live credential file (defense-in-depth; also matched by .env.*)
/.env.papyr
*.pem
*.key
id_rsa
id_ed25519
*.p12
*.pfx
# Secret-scan reports (may contain matched secrets)
gitleaks-report.json
trufflehog-report.json

# ===== Private local project records =====
/audit-outputs/
/papyr-rebuild-decisions.md
/AGENTS.md
/internal/
/.public-rewrite-work/
/papyr-reference/

# ===== Internal planning records (not public) =====
/docs/superpowers/

# Windows device artifact (accidental `type nul > file`); never commit
nul

# ===== Frontend / Node =====
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
test-results/
playwright-report/
playwright/.cache/

# ===== Backend / Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
.coverage.*

# ===== Deploy / infra local state =====
.vercel/
terraform.tfstate*
*.tfvars

# ===== OS / editor / misc =====
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
## Developer/temp files
tdd/
audit-outputs/

# ===== Local scratch / agent working files =====
/.omp/
/.playwright-mcp/
/nul
/tier3-write-test.txt
/scout-configs.md
/snapshot-*.md

/.wt-*/
/.worktree-*/